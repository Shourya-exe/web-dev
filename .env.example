# ==============================================================================
# Email Inquiry Routing Configuration
# ==============================================================================

# Destination email where customer inquiries will be delivered:
CONTACT_RECEIVER_EMAIL="redefiningarchitecture@gmail.com"

# ------------------------------------------------------------------------------
# OPTION A: Resend API (Recommended for Vercel)
# 1. Sign up at https://resend.com and create an API key
# 2. In testing mode, Resend sends to your signup email (autoneural.official3011@gmail.com).
# 3. To deliver to info@redefiningarchitecture.com, verify your domain at resend.com/domains
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Redefining Architecture <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# OPTION B: SMTP (Gmail / Google Workspace / Zoho / Hostinger)
# For Gmail: Use your email and a 16-character Google App Password (not your normal password)
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ------------------------------------------------------------------------------
# OPTION C: Google Sheets Webhook (Optional inquiry backup)
# ------------------------------------------------------------------------------
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
